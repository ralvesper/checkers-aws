# Reference only: merge with the existing VPS Nginx configuration after validating paths.
# map/limit_req_zone belong inside the http context; do not duplicate them globally.
map $http_upgrade $damas_connection {
    default upgrade;
    '' close;
}
limit_req_zone $binary_remote_addr zone=damas_api:10m rate=5r/s;

server {
    listen 80;
    server_name damas.highonline.com.br;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name damas.highonline.com.br;
    # Example paths; verify the certificate/renewal mechanism actually used on the VPS.
    ssl_certificate /etc/letsencrypt/live/damas.highonline.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/damas.highonline.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location /api/ {
        limit_req zone=damas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $damas_connection;
        proxy_read_timeout 300s;
    }
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
