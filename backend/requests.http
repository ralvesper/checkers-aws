@baseUrl = http://localhost:8080
@black = 11111111-1111-4111-8111-111111111111
@white = 22222222-2222-4222-8222-222222222222

### Criar partida local
POST {{baseUrl}}/games
Content-Type: application/json
X-Player-Id: {{white}}

{
  "blackPlayerId": "{{black}}",
  "whitePlayerId": "{{white}}"
}

> {% client.global.set("gameId", response.body.id); %}

### Consultar partida
GET {{baseUrl}}/games/{{gameId}}
X-Player-Id: {{white}}

### Primeiro lance (reexecutar o mesmo bloco testa idempotência)
POST {{baseUrl}}/games/{{gameId}}/moves
Content-Type: application/json
X-Player-Id: {{white}}

{
  "from": { "row": 5, "column": 0 },
  "landings": [{ "row": 4, "column": 1 }],
  "expectedVersion": 0,
  "clientMoveId": "33333333-3333-4333-8333-333333333333"
}
