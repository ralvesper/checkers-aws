# Local development only. Copy to .env and choose your own password.
CHECKERS_DATABASE_PASSWORD=change-me-local-only
CHECKERS_POSTGRES_PORT=5432
# Generate with: openssl rand -hex 32. Keep the same value across restarts.
CHECKERS_SESSION_SECRET=
CHECKERS_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
